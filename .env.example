# =============================================================================
# QUIZMANIA ENVIRONMENT CONFIGURATION
# =============================================================================
#
# IMPORTANT SECURITY NOTICE:
# Any variable prefixed with "VITE_" is embedded into the browser-facing JavaScript
# bundle during build time. NEVER place database connection strings, service-role keys,
# master passwords, or admin tokens in client-facing environment variables!
# =============================================================================

# Supabase Cloud Project Configuration (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here
